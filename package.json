{
  "name": "impact-theory",
  "private": true,
  "version": "1.18.0+27",
  "type": "module",
  "description": "A physics demolition game. Fire balls from a cannon at structures built from a fifteen piece block kit and bring them down.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "npm run convert:blocks",
    "dev": "vite",
    "prebuild": "npm run convert:blocks",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run convert:blocks",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "e2e": "playwright test",
    "convert:blocks": "node scripts/convert-blocks.mjs",
    "verify": "npm run lint && npm run test",
    "serve:dist": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.20.0",
    "three": "^0.185.1",
    "vite-plugin-wasm": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
